prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: pdn_aprs
Description: APRS encoder and decoder in C99
URL: https://github.com/packet-net/aprs-c
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lpdn_aprs
Libs.private: @PDN_APRS_PC_LIBS@
Cflags: -I${includedir}
